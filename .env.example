# Public ImageKit delivery endpoint, for example: https://ik.imagekit.io/your_id
PUBLIC_IMAGEKIT_URL_ENDPOINT=

# ImageKit's public key is safe to expose to the browser and is used by the
# media picker after its server-side upload signature has been enabled.
PUBLIC_IMAGEKIT_PUBLIC_KEY=

# Add this only after `bunx convex dev` creates a deployment.
PUBLIC_CONVEX_URL=

# Production canonical URL used by Astro during the build. Keep this aligned
# with the Domain & SEO setting saved in the admin panel.
PUBLIC_SITE_URL=

# Set in the Convex environment (never in this file) before authorising the
# first CMS owner: bunx convex env set ADMIN_EMAIL owner@example.com
# ADMIN_EMAIL=

# Keep these in the Convex environment only — never in .env.local or client
# code. They are used to mint short-lived upload credentials for signed-in
# owners:
# bunx convex env set IMAGEKIT_PRIVATE_KEY your_private_key
# bunx convex env set IMAGEKIT_PUBLIC_KEY your_public_key
# bunx convex env set IMAGEKIT_URL_ENDPOINT https://ik.imagekit.io/your_id

# AI provider secrets stay in Convex. Set the encryption key before using the
# AI settings panel, then add Gemini keys through /admin (AI settings).
# bunx convex env set AI_KEYS_ENCRYPTION_SECRET "use-a-long-random-secret"
# Optional fallback when no provider record exists:
# bunx convex env set GEMINI_API_KEY "AIza..."
# bunx convex env set GEMINI_MODEL "gemini-3.6-flash"
# Optional research fallback when no provider record exists. Deep Research
# models use the Interactions API; Gemini Pro/Flash values use generateContent.
# bunx convex env set GEMINI_RESEARCH_MODEL "gemini-3.1-pro-preview"
