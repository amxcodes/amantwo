---
import "@fontsource/dm-mono/latin-300.css";
import "@fontsource/dm-mono/latin-400.css";
import "@fontsource/dm-mono/latin-500.css";
import "@fontsource/gochi-hand/400.css";
import "../styles/inter-latin.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;
const canonicalUrl =
  canonicalPath && Astro.site
    ? new URL(canonicalPath, Astro.site).href
    : undefined;
---

<!doctype html>
<html lang="en" data-theme="dark" data-theme-mode="dark">
  <head>
    <script is:inline>
      (() => {
        const key = "aman-theme";
        const stored = (() => {
          try { return localStorage.getItem(key); } catch { return null; }
        })();
        // The portfolio opens in its near-black navy variant. A stored choice
        // still wins, so returning visitors can keep light or system mode.
        const mode = stored === "light" || stored === "dark" ? stored : "dark";
        const prefersDark = window.matchMedia?.("(prefers-color-scheme: dark)").matches ?? false;
        const dark = mode === "dark" || (mode === "system" && prefersDark);
        const root = document.documentElement;
        root.dataset.theme = dark ? "dark" : "light";
        root.dataset.themeMode = mode;
        root.style.colorScheme = dark ? "dark" : "light";
        const themeColor = dark ? "#02050b" : "#f5f3ed";
        const updateThemeColor = () => {
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", themeColor);
        };
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", updateThemeColor, { once: true });
        } else {
          updateThemeColor();
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta name="theme-color" content="#02050b" />
    <link rel="preconnect" href="https://assets.watermelon.sh" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <nav class="edge-scroll-rail" data-edge-scroll-rail aria-label="Page sections"></nav>
    <script>
      import "../scripts/theme";
      import "../scripts/motion-loader";
    </script>
  </body>
</html>
