---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import TrustPage from "../components/TrustPage.astro";
import { siteData } from "../content/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicConvexUrl } from "../lib/publicConfig";
---

<BaseLayout title="Developer and agent resources — Aman Anu" description="Public machine-readable resources and browser-agent guidance for amananu.me." canonicalPath="/developers" markdownPath="/developers.md">
  <div class="page-shell">
    <SiteHeader {...siteData.identity} convexUrl={publicConvexUrl} />
    <TrustPage eyebrow="Developer and agent resources" title="Public context, made easier to verify." lead="These resources help browsers, assistants, and developers understand Aman Anu’s public portfolio without guessing.">
      <h2>Start here</h2>
      <p>Read <a href="/llms.txt">llms.txt</a> for a concise navigation index, then use <a href="/llms-full.txt">llms-full.txt</a> when a question needs richer public context. The <a href="/index.md">markdown homepage</a> is a compact, fetchable representation of the portfolio root. Each trust page also has a markdown twin, and the homepage supports <code>Accept: text/markdown</code> content negotiation.</p>
      <h2>Browser tools</h2>
      <p>In browsers that support WebMCP, the public site registers two read-only tools: <code>amananu_get_profile</code> returns verified public profile context, and <code>amananu_open_section</code> moves the browser to a named public portfolio section. These tools are limited to this page context; they do not modify data, access private systems, issue credentials, or act on Aman's behalf.</p>
      <h2>Discovery documents</h2>
      <p>The site publishes an <a href="/.well-known/ard.json">Agentic Resource Discovery catalog</a>, an interoperable <a href="/.well-known/ai-catalog.json">AI Catalog</a>, an integrity-checked <a href="/.well-known/agent-skills/index.json">Agent Skills index</a>, and an <a href="/schemamap.xml">NLWeb Schema Map</a>. The public source repository includes an <a href="https://github.com/amxcodes/amantwo/tree/main/agent-plugin">Agent Plugins package</a> and a repository-level <a href="https://github.com/amxcodes/amantwo/blob/main/AGENTS.md">AGENTS.md</a> that explain how to use the public portfolio context accurately.</p>
      <h2>Authentication, API, and sandbox status</h2>
      <p>amananu.me is a personal portfolio, not a public developer platform. It does not currently provide an API, API keys, OAuth authorization server, OAuth protected resource, MCP endpoint, SDK, CLI, test sandbox, payment service, or agent-to-agent action endpoint. Do not infer any of those capabilities from the presence of these discovery files. For a real collaboration or product enquiry, use the <a href="/contact">contact page</a>.</p>
    </TrustPage>
    <SiteFooter email={siteData.identity.email} />
  </div>
</BaseLayout>
