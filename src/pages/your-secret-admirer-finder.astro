---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Your Secret Admirer Finder"
  description="A one-tap secret admirer prank with a cybersecurity twist."
  canonicalPath="/your-secret-admirer-finder"
>
  <main class="admirer-page" id="main-content" data-admirer>
    <section class="invite" data-invite aria-labelledby="invite-title">
      <span class="heart" aria-hidden="true">♥</span>
      <p class="eyebrow">A LITTLE MYSTERY</p>
      <h1 id="invite-title">Someone has a <em>secret</em> crush on you.</h1>
      <button type="button" data-reveal>Open note</button>
    </section>

    <section class="reveal" data-result aria-labelledby="result-title" hidden>
      <div class="impact" aria-hidden="true">
        <span class="wire" style="--angle: 0deg"></span>
        <span class="wire" style="--angle: 45deg"></span>
        <span class="wire" style="--angle: 90deg"></span>
        <span class="wire" style="--angle: 135deg"></span>
        <span class="wire" style="--angle: 180deg"></span>
        <span class="wire" style="--angle: 225deg"></span>
        <span class="wire" style="--angle: 270deg"></span>
        <span class="wire" style="--angle: 315deg"></span>
        <svg class="shield" viewBox="0 0 160 180" role="presentation">
          <path class="shield-outline" d="M80 9 140 31v48c0 42-25 70-60 92C45 149 20 121 20 79V31L80 9Z" />
          <path class="shield-crack" d="m94 27-20 34 17 15-24 25 13 13-14 36" />
        </svg>
      </div>
      <div class="reveal-copy">
        <p class="eyebrow">CYBERSECURITY TEST <span aria-hidden="true">/</span> PHISHING</p>
        <h2 id="result-title" tabindex="-1">YOU FAILED THE TEST.</h2>
        <p class="result-message">That was easy, friend. A real phish could trick you into handing over your account details.</p>
        <button class="siren-control" type="button" data-siren-toggle aria-pressed="true">Mute siren</button>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const page = document.querySelector("[data-admirer]");
      const invite = page?.querySelector("[data-invite]");
      const result = page?.querySelector("[data-result]");
      const sirenControl = page?.querySelector("[data-siren-toggle]");
      let stopSiren = null;

      const startSiren = () => {
        try {
          const context = new AudioContext();
          const tone = context.createOscillator();
          const sweep = context.createOscillator();
          const sweepDepth = context.createGain();
          const volume = context.createGain();

          tone.type = "sine";
          tone.frequency.value = 780;
          sweep.type = "triangle";
          sweep.frequency.value = 0.8;
          sweepDepth.gain.value = 280;
          volume.gain.setValueAtTime(0.001, context.currentTime);
          volume.gain.exponentialRampToValueAtTime(1, context.currentTime + 0.04);

          sweep.connect(sweepDepth).connect(tone.frequency);
          tone.connect(volume).connect(context.destination);
          tone.start();
          sweep.start();
          void context.resume();
          stopSiren = () => {
            volume.gain.setTargetAtTime(0, context.currentTime, 0.015);
            window.setTimeout(() => {
              tone.stop();
              sweep.stop();
              void context.close();
            }, 100);
          };
          sirenControl.textContent = "Mute siren";
          sirenControl.setAttribute("aria-pressed", "true");
        } catch {
          sirenControl.hidden = true;
        }
      };

      page?.querySelector("[data-reveal]")?.addEventListener("click", () => {
        invite.hidden = true;
        result.hidden = false;
        page.classList.add("is-revealed");
        startSiren();
        result.querySelector("h2")?.focus({ preventScroll: true });
      });

      sirenControl?.addEventListener("click", () => {
        if (stopSiren) {
          stopSiren();
          stopSiren = null;
          sirenControl.textContent = "Play siren";
          sirenControl.setAttribute("aria-pressed", "false");
        } else {
          startSiren();
        }
      });

      window.addEventListener("pagehide", () => stopSiren?.(), { once: true });
    })();
  </script>

  <style>
    :global(body) { background: #f7e8df; }
    :global(.edge-scroll-rail) { display: none !important; }

    .admirer-page {
      --ink: #34242f;
      --pink: #e85c73;
      display: grid;
      min-height: 100svh;
      place-items: center;
      overflow: hidden;
      padding: 24px;
      background:
        radial-gradient(ellipse at 50% 115%, rgb(243 166 159 / 34%), transparent 55%),
        #f7e8df;
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      transition: background-color 260ms ease, color 260ms ease;
    }

    :global(html[data-theme="dark"] #main-content.admirer-page:not(.is-revealed)) {
      --ink: #fff5ee;
      --pink: #ff8da0;
      background: #100d12;
      color: var(--ink);
    }
    :global(html[data-theme="dark"] #main-content.admirer-page:not(.is-revealed)) .eyebrow { color: #eab8c2; }

    .invite { width: min(100%, 680px); text-align: center; }
    .heart { display: block; margin-bottom: 26px; color: var(--pink); font-size: 30px; }
    .eyebrow { margin: 0 0 23px; color: #987985; font: 500 10px/1.3 "DM Mono", monospace; letter-spacing: .2em; }
    .invite h1 {
      max-width: 13ch;
      margin: 0 auto 34px;
      font-size: clamp(48px, 10vw, 96px);
      font-weight: 550;
      letter-spacing: -.075em;
      line-height: .94;
      text-wrap: balance;
    }
    .invite h1 em { color: var(--pink); font-family: "Gochi Hand", cursive; font-weight: 400; letter-spacing: -.04em; }
    .invite button {
      display: inline-flex;
      min-height: 54px;
      align-items: center;
      justify-content: center;
      min-width: 128px;
      border: 0;
      border-radius: 999px;
      padding: 0 23px 0 27px;
      background: var(--pink);
      box-shadow: 0 9px 22px rgb(177 67 89 / 20%);
      color: #351722;
      font: 600 14px/1 Inter, sans-serif;
      cursor: pointer;
      transition: background-color 140ms ease, transform 140ms ease;
    }
    .invite button:hover { transform: translateY(-2px); background: #f07888; }
    .invite button:active { transform: scale(.96); }
    button:focus-visible { outline: 3px solid #8d2440; outline-offset: 4px; }

    .admirer-page.is-revealed {
      background:
        radial-gradient(ellipse at 50% 48%, rgb(126 17 37 / 25%), transparent 50%),
        #100d12;
      color: #fff5ee;
    }
    :global(html[data-theme="dark"] #main-content.admirer-page.is-revealed) {
      background: radial-gradient(ellipse at 50% 48%, rgb(126 17 37 / 25%), transparent 50%), #100d12;
      color: #fff5ee;
    }
    .reveal { position: relative; display: grid; width: min(100%, 920px); min-height: calc(100svh - 48px); align-content: center; justify-items: center; text-align: center; }
    .reveal[hidden] { display: none; }
    .impact { position: absolute; inset: 0; overflow: visible; pointer-events: none; }
    .wire { position: absolute; top: 50%; left: 50%; width: max(70vw, 700px); height: 2px; transform: rotate(var(--angle)) scaleX(0); transform-origin: left center; opacity: 0; background: linear-gradient(90deg, #fff, #ff254e 32%, rgb(255 37 78 / 0%) 100%); box-shadow: 0 0 11px #ff254e, 0 0 24px rgb(255 37 78 / 85%); animation: wire-strike 700ms cubic-bezier(.1,.75,.18,1) forwards; }
    .wire:nth-child(2n) { animation-delay: 45ms; }
    .wire:nth-child(3n) { animation-delay: 85ms; }
    .shield { position: absolute; z-index: 1; top: max(12px, calc(50% - 245px)); left: 50%; width: clamp(126px, 23vw, 200px); overflow: visible; transform: translateX(-50%); filter: drop-shadow(0 0 16px rgb(255 27 67 / 70%)); animation: shield-break 800ms cubic-bezier(.16,.74,.2,1) 180ms both; }
    .shield-outline { fill: #171219; stroke: #ff3b5c; stroke-width: 5; stroke-linejoin: round; }
    .shield-crack { fill: none; stroke: #fff2e8; stroke-width: 5; stroke-linecap: square; stroke-linejoin: bevel; stroke-dasharray: 190; stroke-dashoffset: 190; filter: drop-shadow(0 0 5px #ff214b); animation: crack-open 260ms ease-out 540ms forwards; }
    .reveal-copy { position: relative; z-index: 2; width: min(100%, 780px); padding: clamp(220px, 34svh, 300px) 12px 0; }
    .reveal .eyebrow { margin-bottom: 18px; color: #ff7180; }
    .reveal h2 {
      margin: 0;
      color: #fff5ee;
      font-size: clamp(48px, 10vw, 100px);
      font-weight: 800;
      letter-spacing: -.075em;
      line-height: .9;
      text-wrap: balance;
    }
    .reveal h2:focus { outline: none; }
    .result-message { max-width: 42ch; margin: 20px auto 0; color: #f3b8bc; font-size: clamp(15px, 2.4vw, 19px); line-height: 1.55; text-wrap: balance; }
    .siren-control { min-height: 40px; margin-top: 24px; border: 1px solid rgb(255 113 128 / 55%); border-radius: 999px; padding: 0 16px; background: rgb(255 255 255 / 5%); color: #ffe9ea; font: 500 11px/1 "DM Mono", monospace; letter-spacing: .08em; cursor: pointer; transition: background-color 140ms ease, border-color 140ms ease; }
    .siren-control:hover { border-color: #ff7180; background: rgb(255 113 128 / 14%); }
    @keyframes wire-strike { 0% { opacity: 0; transform: rotate(var(--angle)) scaleX(0); } 18% { opacity: 1; } 75% { opacity: .9; } 100% { opacity: .18; transform: rotate(var(--angle)) scaleX(1); } }
    @keyframes shield-break { 0% { opacity: 0; scale: .65; rotate: -8deg; } 25% { opacity: 1; scale: 1.06; rotate: 2deg; } 42% { scale: .97; rotate: -2deg; } 60% { scale: 1.02; rotate: 2deg; } 100% { opacity: 1; scale: 1; rotate: 0deg; } }
    @keyframes crack-open { to { stroke-dashoffset: 0; } }

    @media (max-width: 520px) {
      .admirer-page { padding: 20px; }
      .invite h1 { max-width: 10ch; font-size: clamp(51px, 14vw, 72px); }
      .reveal { min-height: 86svh; }
      .reveal-copy { padding-top: 255px; }
      .shield { top: max(12px, calc(50% - 265px)); }
      .reveal h2 { font-size: clamp(44px, 12vw, 66px); }
      .wire { width: max(100vw, 430px); }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-delay: 0ms !important; transition-duration: .01ms !important; }
      .wire { transform: rotate(var(--angle)) scaleX(1); opacity: .2; }
      .shield { opacity: .35; transform: translateX(-50%); }
      .shield-crack { stroke-dashoffset: 0; }
    }
  </style>
</BaseLayout>
