---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Your Secret Admirer Finder"
  description="A one-tap secret admirer prank with a cybersecurity twist."
  canonicalPath="/your-secret-admirer-finder"
>
  <main class="admirer-page" id="main-content" data-admirer>
    <section class="invite" data-invite aria-labelledby="invite-title">
      <span class="heart" aria-hidden="true">♥</span>
      <p class="eyebrow">A LITTLE MYSTERY</p>
      <h1 id="invite-title">Someone has a <em>secret</em> crush on you.</h1>
      <button type="button" data-reveal>Find out <span aria-hidden="true">↗</span></button>
    </section>

    <section class="reveal" data-result aria-labelledby="result-title" hidden>
      <p class="eyebrow">CYBERSECURITY TEST <span aria-hidden="true">/</span> 01</p>
      <h2 id="result-title" tabindex="-1">YOU FAILED.</h2>
      <p class="result-message">You clicked the bait, friend.</p>
      <span class="result-mark" aria-hidden="true">✳</span>
    </section>
  </main>

  <script is:inline>
    (() => {
      const page = document.querySelector("[data-admirer]");
      const invite = page?.querySelector("[data-invite]");
      const result = page?.querySelector("[data-result]");

      page?.querySelector("[data-reveal]")?.addEventListener("click", () => {
        invite.hidden = true;
        result.hidden = false;
        page.classList.add("is-revealed");
        result.querySelector("h2")?.focus({ preventScroll: true });
      });
    })();
  </script>

  <style>
    :global(body) { background: #f7e8df; }
    :global(.edge-scroll-rail) { display: none !important; }

    .admirer-page {
      --ink: #34242f;
      --pink: #e85c73;
      display: grid;
      min-height: 100svh;
      place-items: center;
      overflow: hidden;
      padding: 24px;
      background:
        radial-gradient(ellipse at 50% 115%, rgb(243 166 159 / 34%), transparent 55%),
        #f7e8df;
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      transition: background-color 300ms ease;
    }

    .invite { width: min(100%, 680px); text-align: center; }
    .heart { display: block; margin-bottom: 26px; color: var(--pink); font-size: 30px; }
    .eyebrow { margin: 0 0 23px; color: #987985; font: 500 10px/1.3 "DM Mono", monospace; letter-spacing: .2em; }
    .invite h1 {
      max-width: 13ch;
      margin: 0 auto 34px;
      font-size: clamp(48px, 10vw, 96px);
      font-weight: 550;
      letter-spacing: -.075em;
      line-height: .94;
      text-wrap: balance;
    }
    .invite h1 em { color: var(--pink); font-family: "Gochi Hand", cursive; font-weight: 400; letter-spacing: -.04em; }
    .invite button {
      display: inline-flex;
      min-height: 54px;
      align-items: center;
      gap: 28px;
      border: 0;
      border-radius: 999px;
      padding: 0 23px 0 27px;
      background: var(--pink);
      box-shadow: 0 9px 22px rgb(177 67 89 / 20%);
      color: #fffaf4;
      font: 600 14px/1 Inter, sans-serif;
      cursor: pointer;
      transition: background-color 140ms ease, transform 140ms ease;
    }
    .invite button:hover { transform: translateY(-2px); background: #d94d68; }
    button:focus-visible { outline: 3px solid #8d2440; outline-offset: 4px; }

    .admirer-page.is-revealed {
      background:
        radial-gradient(ellipse at 50% 48%, rgb(126 17 37 / 25%), transparent 50%),
        #100d12;
      color: #fff5ee;
    }
    .reveal { width: min(100%, 920px); text-align: center; animation: reveal-in 350ms cubic-bezier(.2,.8,.2,1) both; }
    .reveal[hidden] { display: none; }
    .reveal .eyebrow { color: #ff7180; }
    .reveal h2 {
      margin: 0;
      color: #fff5ee;
      font-size: clamp(76px, 19vw, 190px);
      font-weight: 750;
      letter-spacing: -.09em;
      line-height: .8;
      text-wrap: balance;
    }
    .reveal h2:focus { outline: none; }
    .result-message { margin: 28px 0 0; color: #f3b8bc; font-size: clamp(17px, 3vw, 23px); letter-spacing: -.025em; }
    .result-mark { display: block; margin-top: 43px; color: #ff596e; font-size: 28px; }
    @keyframes reveal-in { from { opacity: 0; transform: scale(.97); } to { opacity: 1; transform: scale(1); } }

    @media (max-width: 520px) {
      .admirer-page { padding: 20px; }
      .invite h1 { max-width: 10ch; font-size: clamp(51px, 14vw, 72px); }
      .reveal h2 { font-size: clamp(74px, 22vw, 116px); }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</BaseLayout>