---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Your Secret Admirer Finder"
  description="A tiny, playful friend test to see whether curiosity beats caution. No personal information is collected."
  canonicalPath="/your-secret-admirer-finder"
>
  <main class="admirer-page" id="main-content" data-admirer>
    <div class="admirer-orbit admirer-orbit-one" aria-hidden="true">✳</div>
    <div class="admirer-orbit admirer-orbit-two" aria-hidden="true">♡</div>

    <div class="admirer-wrap">
      <div class="admirer-masthead" role="group" aria-label="A tiny friend test">
        <span class="masthead-mark" aria-hidden="true">♡</span>
        <span>THE SECRET ADMIRER FINDER</span>
        <span class="masthead-dot" aria-hidden="true"></span>
        <span class="masthead-edition">A TINY FRIEND TEST</span>
      </div>

      <div class="admirer-card">
        <div class="card-stamp" aria-hidden="true"><span>✳</span><small>NO. 01</small></div>

        <section class="admirer-panel is-active" data-panel="0" aria-labelledby="intro-title">
          <p class="panel-kicker"><span class="kicker-line"></span> A MYSTERY IN THREE STEPS</p>
          <h1 id="intro-title" tabindex="-1">Someone has a <em>secret</em> crush on you.</h1>
          <p class="panel-copy">There are a few clues to follow. Trust your gut, friend.</p>
          <button class="primary-action" type="button" data-next>
            Find my admirer <span aria-hidden="true">↗</span>
          </button>
          <p class="privacy-note"><span aria-hidden="true">✦</span> Just for fun. No real links or personal info.</p>
        </section>

        <section class="admirer-panel" data-panel="1" aria-labelledby="clue-one-title" hidden>
          <div class="step-meta"><span>CLUE ONE</span><span>01 <i>/</i> 03</span></div>
          <div class="progress-track" role="progressbar" aria-label="Test progress" aria-valuemin="1" aria-valuemax="3" aria-valuenow="1"><span style="--progress: 33.333%"></span></div>
          <h2 id="clue-one-title" tabindex="-1">A message says, “Someone has a crush on you 💌” with a mystery link.</h2>
          <p class="panel-copy">What’s your first move?</p>
          <div class="answer-list">
            <button class="answer-option" type="button" data-choice="risky"><span class="answer-icon" aria-hidden="true">↗</span><span>Tap it before the clue disappears</span><span class="answer-arrow" aria-hidden="true">→</span></button>
            <button class="answer-option" type="button" data-choice="safe"><span class="answer-icon" aria-hidden="true">?</span><span>Check who sent it first</span><span class="answer-arrow" aria-hidden="true">→</span></button>
            <button class="answer-option" type="button" data-choice="risky"><span class="answer-icon" aria-hidden="true">↗</span><span>Forward it to the group chat</span><span class="answer-arrow" aria-hidden="true">→</span></button>
          </div>
        </section>

        <section class="admirer-panel" data-panel="2" aria-labelledby="clue-two-title" hidden>
          <div class="step-meta"><span>CLUE TWO</span><span>02 <i>/</i> 03</span></div>
          <div class="progress-track" role="progressbar" aria-label="Test progress" aria-valuemin="1" aria-valuemax="3" aria-valuenow="2"><span style="--progress: 66.667%"></span></div>
          <h2 id="clue-two-title" tabindex="-1">The page asks for your birthday to reveal the admirer’s name.</h2>
          <p class="panel-copy">Seems like a lot to ask for a crush, doesn’t it?</p>
          <div class="answer-list">
            <button class="answer-option" type="button" data-choice="risky"><span class="answer-icon" aria-hidden="true">♡</span><span>Sure, birthdays aren’t a secret</span><span class="answer-arrow" aria-hidden="true">→</span></button>
            <button class="answer-option" type="button" data-choice="safe"><span class="answer-icon" aria-hidden="true">✕</span><span>Nope. Let the admirer stay mysterious</span><span class="answer-arrow" aria-hidden="true">→</span></button>
          </div>
        </section>

        <section class="admirer-panel" data-panel="3" aria-labelledby="final-clue-title" hidden>
          <div class="step-meta"><span>THE FINAL CLUE</span><span>03 <i>/</i> 03</span></div>
          <div class="progress-track" role="progressbar" aria-label="Test progress" aria-valuemin="1" aria-valuemax="3" aria-valuenow="3"><span style="--progress: 100%"></span></div>
          <div class="final-envelope" aria-hidden="true"><span>♡</span></div>
          <h2 id="final-clue-title" tabindex="-1">One last tap to reveal who’s been thinking about you.</h2>
          <p class="panel-copy">Ready for the big reveal?</p>
          <button class="primary-action" type="button" data-reveal>
            Reveal my admirer <span aria-hidden="true">↗</span>
          </button>
          <p class="privacy-note"><span aria-hidden="true">✦</span> There’s no external link behind this button.</p>
        </section>

        <section class="admirer-panel result-panel" data-panel="4" aria-labelledby="result-title" hidden>
          <p class="panel-kicker"><span class="kicker-line"></span> PLOT TWIST</p>
          <div class="result-heart" aria-hidden="true">♡</div>
          <h2 id="result-title" tabindex="-1">You’ve been <em>phished, friend.</em></h2>
          <p class="result-score" data-result-score></p>
          <p class="result-copy">The admirer was curiosity all along. This was a pretend test: nothing was sent, stored, or collected.</p>
          <div class="lesson-note">
            <span class="lesson-spark" aria-hidden="true">✳</span>
            <p><strong>Real-life clue:</strong> pause on unexpected links and requests for personal details. Verify with the sender another way.</p>
          </div>
          <button class="restart-action" type="button" data-restart>Run it back <span aria-hidden="true">↻</span></button>
        </section>

        <div class="card-footer"><span>MADE WITH CURIOSITY</span><span aria-hidden="true">✳</span><span>NO DATA COLLECTED</span></div>
      </div>

      <p class="admirer-signoff">A little reminder from a friend, with love <span aria-hidden="true">♡</span></p>
      <noscript><p class="no-script-note">This tiny test needs JavaScript for the step-by-step reveal. No personal information is collected.</p></noscript>
    </div>
  </main>

  <script is:inline>
    (() => {
      const root = document.querySelector("[data-admirer]");
      if (!root) return;

      const panels = [...root.querySelectorAll("[data-panel]")];
      let current = 0;
      let safeAnswers = 0;

      const showPanel = (index) => {
        current = index;
        panels.forEach((panel, panelIndex) => {
          panel.hidden = panelIndex !== index;
          panel.classList.toggle("is-active", panelIndex === index);
        });
        panels[index]?.querySelector("h1, h2")?.focus({ preventScroll: true });
      };

      root.addEventListener("click", (event) => {
        const button = event.target.closest("button");
        if (!button) return;

        if (button.hasAttribute("data-next")) showPanel(current + 1);
        if (button.hasAttribute("data-choice")) {
          if (button.dataset.choice === "safe") safeAnswers += 1;
          showPanel(current + 1);
        }
        if (button.hasAttribute("data-reveal")) {
          const score = root.querySelector("[data-result-score]");
          const messages = [
            "Curiosity: 2, caution: 0. You clicked right into it, friend.",
            "You caught one red flag. Curiosity got the other one.",
            "You spotted both red flags… then clicked our harmless reveal anyway. We got you on the friend test.",
          ];
          score.textContent = messages[safeAnswers] || messages[0];
          showPanel(4);
        }
        if (button.hasAttribute("data-restart")) {
          safeAnswers = 0;
          showPanel(0);
        }
      });
    })();
  </script>

  <style>
    :global(body) { background: #f7e8df; color: #302334; }
    :global(.edge-scroll-rail) { display: none !important; }
    .admirer-page {
      --ad-ink: #302334;
      --ad-muted: #806f79;
      --ad-pink: #e85c73;
      --ad-paper: #fffaf4;
      --ad-line: #eadbd4;
      position: relative;
      display: grid;
      min-height: 100svh;
      overflow: hidden;
      place-items: center;
      padding: clamp(24px, 6vw, 72px) 18px;
      background:
        radial-gradient(ellipse at 8% 18%, rgb(255 255 255 / 50%), transparent 30%),
        radial-gradient(ellipse at 91% 83%, rgb(249 192 180 / 38%), transparent 29%),
        #f7e8df;
      color: var(--ad-ink);
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    }
    .admirer-orbit { position: absolute; color: #df7180; pointer-events: none; }
    .admirer-orbit-one { top: 12%; left: max(5%, calc(50% - 490px)); font-size: 33px; transform: rotate(-14deg); }
    .admirer-orbit-two { right: max(6%, calc(50% - 500px)); bottom: 14%; font: 58px/1 Georgia, serif; transform: rotate(12deg); }
    .admirer-wrap { position: relative; z-index: 1; width: min(100%, 560px); }
    .admirer-masthead { display: flex; align-items: center; justify-content: center; gap: 9px; margin: 0 0 15px; color: #775d68; font: 500 9px/1.2 "DM Mono", monospace; letter-spacing: .11em; }
    .masthead-mark { color: var(--ad-pink); font-size: 16px; }
    .masthead-dot { width: 3px; height: 3px; border-radius: 50%; background: #c6979a; }
    .masthead-edition { color: #a17c82; }
    .admirer-card { position: relative; padding: clamp(28px, 7vw, 56px) clamp(22px, 7vw, 58px) 0; overflow: hidden; border: 1px solid rgb(73 43 58 / 9%); border-radius: 28px; background: var(--ad-paper); box-shadow: 0 25px 72px rgb(94 53 67 / 12%), 0 3px 8px rgb(94 53 67 / 5%); }
    .card-stamp { position: absolute; top: 19px; right: 20px; display: grid; width: 49px; height: 49px; align-content: center; justify-items: center; border: 1px solid #f0cad0; border-radius: 50%; color: var(--ad-pink); transform: rotate(9deg); }
    .card-stamp span { font-size: 16px; line-height: 1; }
    .card-stamp small { margin-top: 2px; font: 500 7px/1 "DM Mono", monospace; letter-spacing: .04em; }
    .admirer-panel { min-height: 388px; padding: 15px 0 33px; animation: card-arrive 260ms cubic-bezier(.2,.75,.25,1) both; }
    .admirer-panel[hidden] { display: none; }
    @keyframes card-arrive { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .panel-kicker { display: flex; align-items: center; gap: 9px; margin: 0 0 21px; color: var(--ad-pink); font: 500 9px/1.3 "DM Mono", monospace; letter-spacing: .14em; }
    .kicker-line { width: 22px; height: 1px; background: currentColor; }
    .admirer-panel h1, .admirer-panel h2 { max-width: 12ch; margin: 0; color: var(--ad-ink); font-size: clamp(35px, 7vw, 52px); font-weight: 550; letter-spacing: -.065em; line-height: .99; text-wrap: balance; }
    .admirer-panel h1 em, .admirer-panel h2 em { color: var(--ad-pink); font-family: "Gochi Hand", cursive; font-size: 1.08em; font-weight: 400; letter-spacing: -.03em; }
    .admirer-panel h2 { max-width: 18ch; font-size: clamp(27px, 5.5vw, 39px); line-height: 1.08; }
    .admirer-panel h1:focus, .admirer-panel h2:focus { outline: none; }
    .panel-copy { max-width: 39ch; margin: 17px 0 24px; color: var(--ad-muted); font-size: 14px; line-height: 1.65; }
    .primary-action { display: inline-flex; min-height: 50px; align-items: center; justify-content: center; gap: 22px; border: 0; border-radius: 999px; padding: 0 22px 0 24px; background: var(--ad-pink); color: white; font: 600 13px/1 Inter, sans-serif; cursor: pointer; box-shadow: 0 7px 16px rgb(232 92 115 / 19%); transition: background-color 140ms ease, transform 140ms ease, box-shadow 140ms ease; }
    .primary-action span { font-size: 16px; transition: transform 140ms ease; }
    .primary-action:hover { background: #d84a64; box-shadow: 0 9px 20px rgb(232 92 115 / 25%); }
    .primary-action:hover span { transform: translate(2px, -2px); }
    button:focus-visible { outline: 3px solid #a23b58; outline-offset: 3px; }
    .privacy-note { display: flex; align-items: center; gap: 7px; margin: 20px 0 0; color: #9a8790; font-size: 10px; line-height: 1.4; }
    .privacy-note span { color: #d28486; }
    .step-meta { display: flex; align-items: center; justify-content: space-between; margin: 0 0 12px; color: #936e79; font: 500 9px/1.2 "DM Mono", monospace; letter-spacing: .12em; }
    .step-meta i { padding: 0 3px; color: #c6a5aa; font-style: normal; }
    .progress-track { height: 3px; margin-bottom: 31px; overflow: hidden; border-radius: 4px; background: #f0e6e0; }
    .progress-track span { display: block; width: var(--progress); height: 100%; border-radius: inherit; background: var(--ad-pink); transition: width 220ms ease; }
    .answer-list { display: grid; gap: 9px; margin-top: 20px; }
    .answer-option { display: grid; grid-template-columns: 29px minmax(0, 1fr) 17px; min-height: 52px; align-items: center; gap: 10px; border: 1px solid var(--ad-line); border-radius: 13px; padding: 8px 13px; background: #fffdf9; color: var(--ad-ink); text-align: left; font: 500 12px/1.45 Inter, sans-serif; cursor: pointer; transition: border-color 140ms ease, background-color 140ms ease, transform 140ms ease; }
    .answer-option:hover { transform: translateY(-1px); border-color: #e99aa4; background: #fff5f3; }
    .answer-icon { display: grid; width: 27px; height: 27px; place-items: center; border-radius: 9px; background: #f9e8e5; color: #bd6876; font: 500 14px/1 Georgia, serif; }
    .answer-arrow { color: #b3949b; text-align: right; font-size: 15px; }
    .final-envelope { display: grid; width: 62px; height: 53px; place-items: center; margin: 0 0 19px; border: 1px solid #efc4ca; border-radius: 13px; background: linear-gradient(145deg, #fff7f2 45%, #ffe2df); color: var(--ad-pink); font: 35px/1 Georgia, serif; transform: rotate(-5deg); }
    .result-panel { padding-top: 24px; }
    .result-heart { position: absolute; top: 37px; right: 73px; display: grid; width: 55px; height: 55px; place-items: center; border-radius: 50%; background: #ffe8e4; color: var(--ad-pink); font: 36px/1 Georgia, serif; transform: rotate(10deg); }
    .result-panel h2 { max-width: 10ch; }
    .result-score { margin: 14px 0 7px; color: #c0445e; font-size: 13px; font-weight: 650; line-height: 1.5; }
    .result-copy { max-width: 44ch; color: var(--ad-muted); font-size: 12px; line-height: 1.65; }
    .lesson-note { display: grid; grid-template-columns: 23px 1fr; gap: 10px; margin: 18px 0 15px; border-radius: 13px; padding: 13px 14px; background: #f7eee3; color: #65525b; }
    .lesson-spark { padding-top: 1px; color: #c98547; font-size: 17px; }
    .lesson-note p { font-size: 11px; line-height: 1.6; }
    .lesson-note strong { color: var(--ad-ink); }
    .restart-action { display: inline-flex; min-height: 39px; align-items: center; gap: 9px; border: 1px solid #ead8d5; border-radius: 999px; padding: 0 14px; background: transparent; color: #785e68; font: 600 11px/1 Inter, sans-serif; cursor: pointer; transition: border-color 140ms ease, background-color 140ms ease; }
    .restart-action:hover { border-color: #dc9aa2; background: #fff5f3; }
    .card-footer { display: flex; min-height: 49px; align-items: center; justify-content: space-between; gap: 10px; border-top: 1px solid #f0e4dd; color: #b39ba0; font: 500 7px/1 "DM Mono", monospace; letter-spacing: .1em; }
    .card-footer span:nth-child(2) { color: #df8d91; font-size: 12px; }
    .admirer-signoff { margin: 17px 0 0; color: #9b7d84; text-align: center; font: 400 12px/1.4 "Gochi Hand", cursive; }
    .admirer-signoff span { color: var(--ad-pink); }
    .no-script-note { margin: 12px 0; color: #725c64; text-align: center; font-size: 12px; line-height: 1.5; }
    @media (max-width: 520px) {
      .admirer-page { padding: 32px 14px; }
      .admirer-orbit-one { top: 5%; left: 7%; font-size: 23px; }
      .admirer-orbit-two { right: 6%; bottom: 5%; font-size: 42px; }
      .admirer-masthead { flex-wrap: wrap; gap: 7px; font-size: 8px; }
      .admirer-card { border-radius: 22px; padding-right: 22px; padding-left: 22px; }
      .card-stamp { top: 13px; right: 13px; width: 42px; height: 42px; }
      .admirer-panel { min-height: 380px; padding-top: 21px; }
      .admirer-panel h1 { max-width: 10ch; font-size: clamp(38px, 11vw, 48px); }
      .admirer-panel h2 { max-width: 16ch; font-size: clamp(27px, 8vw, 36px); }
      .result-heart { top: 52px; right: 37px; width: 45px; height: 45px; font-size: 30px; }
      .result-panel { min-height: 440px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
    }
  </style>
</BaseLayout>
