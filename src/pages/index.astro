---
import AgentModeView from "../components/AgentModeView.astro";
import ManagedPortfolio from "../components/ManagedPortfolio.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteData } from "../content/site";
import { homepageStructuredData } from "../content/structured-data";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicConvexUrl } from "../lib/publicConfig";

// Render the published snapshot into the initial HTML so crawlers and readers
// that do not execute JavaScript still receive the current portfolio content.
export const prerender = false;
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=30, stale-while-revalidate=120",
);
const isAgentMode = Astro.url.searchParams.get("mode") === "agent";
---

<BaseLayout
  title="Aman Anu - Creative technologist"
  description="Aman Anu builds AI systems, products, and moving-image experiences."
  canonicalPath="/"
  markdownPath="/index.md"
  structuredData={homepageStructuredData}
>
  <div class="page-shell">
    <SiteHeader {...siteData.identity} convexUrl={publicConvexUrl} />
    <main id="main-content">
      {isAgentMode ? <AgentModeView /> : <ManagedPortfolio />}
    </main>
    <!-- Keep the footer's visible-only signature hydration on the public page.
         The static island fallback intentionally stays non-interactive, but
         the footer itself owns its reveal animation and newsletter behavior. -->
    <SiteFooter email={siteData.identity.email} />
  </div>
</BaseLayout>
