---
import PublishedWritingCards, { type ArticleCard } from "./PublishedWritingCards";
import { publicConvexUrl } from "../lib/publicConfig";

interface Props {
  posts: ArticleCard[];
  interactive?: boolean;
  nextCursor?: string;
  hasMore?: boolean;
}

const { posts, interactive = true, nextCursor, hasMore = false } = Astro.props;
---

<section class="blog-section" id="writing" aria-labelledby="writing-title" data-reveal="section" data-scroll-label="Writing">
  <div class="blog-heading">
    <p>Notes in progress</p>
    <h2 id="writing-title">A few things I&rsquo;m working through.</h2>
    <span>Products, images, systems, and the details between them.</span>
  </div>

  <!-- The first six public cards are rendered during SSR. Further pages are
       requested only after a visitor chooses Show more. -->
  {interactive ? (
    <PublishedWritingCards
      initialPosts={posts}
      convexUrl={publicConvexUrl}
      nextCursor={nextCursor}
      hasMore={hasMore}
      client:load
    />
  ) : (
    <PublishedWritingCards
      initialPosts={posts}
      convexUrl={publicConvexUrl}
      nextCursor={nextCursor}
      hasMore={hasMore}
    />
  )}
</section>
