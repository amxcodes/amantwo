---
interface Props {
  name: string;
  email: string;
  availability: string;
}

const { name, email, availability } = Astro.props;
---

<header class="site-header" data-reveal="header">
  <a class="wordmark" href="/" aria-label={`${name}, home`}>{name}</a>
  <div class="header-meta">
    <span class="availability" aria-hidden="true">{availability}</span>
    <a class="header-email" href={`mailto:${email}`}>{email}</a>
  </div>
</header>
