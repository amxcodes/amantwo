---
import BrandIcon from "./BrandIcon.astro";
import { FooterSignature } from "./FooterSignature";
import NewsletterForm from "./NewsletterForm";
import { publicConvexUrl } from "../lib/publicConfig";

interface Props {
  email: string;
}

const { email } = Astro.props;
const socialLinks = [
  { label: "Email", brand: "gmail", href: `mailto:${email}` },
  { label: "GitHub", brand: "github", href: "https://github.com/amxcodes" },
  { label: "Instagram", brand: "instagram", href: "https://www.instagram.com/amanxnu/" },
  { label: "YouTube", brand: "youtube", href: "https://www.youtube.com/@Amananu" },
] as const;
---

<footer id="signature-footer" class="signature-footer" data-reveal="section" data-scroll-label="Contact">
  <a class="signature-footer-top" href="#home">Top <span aria-hidden="true">↑</span></a>
  <div class="signature-footer-content">
    <div class="signature-footer-main">
      <FooterSignature client:visible name="Aman" sectionId="signature-footer" />
      <NewsletterForm client:visible convexUrl={publicConvexUrl} fallbackEmail={email} />
      <nav class="signature-footer-socials" aria-label="Aman Anu on social media">
        {socialLinks.map((link) => (
          <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined} aria-label={link.label} title={link.label}>
            <BrandIcon brand={link.brand} />
            <span>{link.label}</span>
          </a>
        ))}
      </nav>
      <p class="signature-footer-meta">© <span data-year></span> Aman Anu · Kochi, India</p>
    </div>
  </div>

  <div class="signature-footer-landscape" aria-hidden="true">
    <img src="/media/footer-landscape.png" alt="" />
  </div>
</footer>
