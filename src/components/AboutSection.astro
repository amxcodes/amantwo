---
import BrandIcon from "./BrandIcon.astro";
import { resolveMediaUrl } from "../lib/media";

interface Props {
  eyebrow: string;
  heading: string;
  description: string;
  portraitSrc: string;
  portraitAlt: string;
  links: Array<{ label: string; href: string }>;
}

const { eyebrow, heading, description, portraitSrc, portraitAlt, links } = Astro.props;
const brandForLabel = {
  Email: "gmail",
  GitHub: "github",
} as const;
---

<section class="about-section" id="about" aria-labelledby="about-title" data-reveal="section" data-scroll-label="About">
  <div class="about-section-copy">
    <p class="about-section-kicker">{eyebrow}</p>
    <h2 id="about-title">{heading}</h2>
    <p class="about-section-description">{description}</p>
    <nav class="about-section-links" aria-label="About Aman links">
      {links.map((link) => (
        <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>
          <BrandIcon brand={brandForLabel[link.label as keyof typeof brandForLabel] ?? "gmail"} />
          <span>{link.label}</span>
        </a>
      ))}
    </nav>
  </div>

  <figure class="about-section-portrait">
    <img
      class="about-section-portrait-image about-portrait-light"
      src={resolveMediaUrl(portraitSrc)}
      alt={portraitAlt}
      width="1254"
      height="1254"
      loading="lazy"
      decoding="async"
    />
    <img
      class="about-section-portrait-image about-portrait-dark"
      src={resolveMediaUrl("/media/aman-about-annotated-dark.png")}
      alt=""
      aria-hidden="true"
      width="1254"
      height="1254"
      loading="lazy"
      decoding="async"
    />
  </figure>
</section>
