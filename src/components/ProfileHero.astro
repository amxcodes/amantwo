---
import ChromaticTextReveal from "./ChromaticTextReveal.astro";
import InlinePortrait from "./InlinePortrait.astro";
import { resolveMediaUrl } from "../lib/media";

interface Props {
  name: string;
  avatarSrc: string;
  portraitSrc: string;
  introduction: string;
  heroClosing: string;
  statement: string;
  location: string;
  heroRoles: string[];
}

const {
  name,
  portraitSrc,
  introduction,
  heroClosing,
  statement,
  location,
  heroRoles,
} = Astro.props;

// The inline avatar uses four verified, source-matched frames per theme. Keeping the
// character and cat in each frame lets the motion stay coherent without extra
// DOM layers, layout shifts, or runtime drawing work. We intentionally keep
// this short source-matched sequence instead of mixing in divergent generated
// frames. Later generated frames are deliberately excluded because their crop,
// background tone, and pose do not match the verified sequence.
const illustratedAvatarSrc = "/media/aman-avatar-illustrated-light.webp";
const illustratedAvatarDarkSrc = "/media/aman-avatar-illustrated-dark.webp";
const illustratedAvatarFrames = [
  "/media/aman-avatar-stop-01-light.webp",
  "/media/aman-avatar-stop-02-light.webp",
  "/media/aman-avatar-stop-03-light.webp",
  "/media/aman-avatar-stop-04-light.webp",
];
const illustratedAvatarDarkFrames = [
  "/media/aman-avatar-stop-01-dark.webp",
  "/media/aman-avatar-stop-02-dark.webp",
  "/media/aman-avatar-stop-03-dark.webp",
  "/media/aman-avatar-stop-04-dark.webp",
];
---

<section class="profile-hero" id="home" aria-labelledby="profile-title" data-scroll-label="Intro">
  <div class="profile-card">
    <h1 id="profile-title" data-reveal="hero">
      <span class="hero-primary">
        <span class="hero-identity">
          <span class="hero-lead">{introduction}</span>
          <InlinePortrait
            compactSrc={resolveMediaUrl(illustratedAvatarSrc)}
            compactDarkSrc={resolveMediaUrl(illustratedAvatarDarkSrc)}
            compactFrames={illustratedAvatarFrames.map(resolveMediaUrl)}
            compactDarkFrames={illustratedAvatarDarkFrames.map(resolveMediaUrl)}
            fullSrc={resolveMediaUrl(portraitSrc)}
            alt={`Portrait of ${name}`}
          />
        </span>
        <span class="hero-role-slot">
          <strong><ChromaticTextReveal words={heroRoles} /></strong>
        </span>
      </span>
      <span class="hero-secondary">{heroClosing}</span>
    </h1>
    <p class="profile-tagline" data-reveal="hero">{statement}</p>
    <p class="location" data-reveal="hero">{location} · Available worldwide</p>
  </div>
</section>
