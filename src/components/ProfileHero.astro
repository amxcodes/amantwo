---
import ChromaticTextReveal from "./ChromaticTextReveal.astro";
import InlinePortrait from "./InlinePortrait.astro";
import { resolveMediaUrl } from "../lib/media";

interface Props {
  name: string;
  avatarSrc: string;
  portraitSrc: string;
  introduction: string;
  heroClosing: string;
  statement: string;
  location: string;
  heroRoles: string[];
}

const {
  name,
  portraitSrc,
  introduction,
  heroClosing,
  statement,
  location,
  heroRoles,
} = Astro.props;

// Keep the inline hero avatar deliberately static. The separate full portrait
// remains available in the existing hover/focus preview.
const illustratedAvatarSrc = "/media/aman-avatar-illustrated.webp";
---

<section class="profile-hero" id="home" aria-labelledby="profile-title" data-scroll-label="Intro">
  <div class="profile-card">
    <h1 id="profile-title" data-reveal="hero">
      <span class="hero-primary">
        <span class="hero-identity">
          <span class="hero-lead">{introduction}</span>
          <InlinePortrait
            compactSrc={resolveMediaUrl(illustratedAvatarSrc)}
            fullSrc={resolveMediaUrl(portraitSrc)}
            alt={`Portrait of ${name}`}
          />
        </span>
        <span class="hero-role-slot">
          <strong><ChromaticTextReveal words={heroRoles} /></strong>
        </span>
      </span>
      <span class="hero-secondary">{heroClosing}</span>
    </h1>
    <p class="profile-tagline" data-reveal="hero">{statement}</p>
    <p class="location" data-reveal="hero">{location} · Available worldwide</p>
  </div>
</section>
